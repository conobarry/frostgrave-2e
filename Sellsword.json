      {
        "name": "Sprint",
        "id": "18ac-7856-128e-93b2",
        "hidden": false,
        "typeId": "43c7-a180-0f5f-6927",
        "typeName": "Trick of the Trade",
        "characteristics": [
          {"name": "Effect", "$text": "+2 Move for the rest of the turn", "typeId": "e708-8a98-c786-d94d"},
          {"name": "When to Declare", "$text": "Upon activation", "typeId": "8bb4-05b2-0fba-6dc3"}
        ]
      },
      {
        "name": "Leadership",
        "id": "d11f-f01f-851c-42ae",
        "hidden": false,
        "typeId": "43c7-a180-0f5f-6927",
        "typeName": "Trick of the Trade",
        "characteristics": [
          {
            "name": "Effect",
            "$text": "If using a Group Activation, the captain may activate up to three soldiers within 3\" who have not already been activated in the turn",
            "typeId": "e708-8a98-c786-d94d"
          },
          {"name": "When to Declare", "$text": "Upon activation", "typeId": "8bb4-05b2-0fba-6dc3"}
        ]
      },
      {
        "name": "Group Activation",
        "id": "1336-d27e-5bd4-a7ec",
        "comment": "Captain",
        "hidden": false,
        "typeId": "862c-226a-1aca-4ed2",
        "typeName": "Ability",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Captains activate just like any other soldier with one exception. If the captain is activating in the Solider Phase, he may declare a Group Activation with one other solider within 3\" of him who has not yet been activated in the turn. The captain and this soldier may both move and then both take their second actions.",
            "typeId": "15c1-2bd7-8969-1787"
          }
        ]
      },
      {
        "name": "Survivor",
        "id": "fc28-4914-a5c4-73f9",
        "hidden": false,
        "typeId": "862c-226a-1aca-4ed2",
        "typeName": "Ability",
        "characteristics": [
          {
            "name": "Description",
            "$text": "If a captain is knocked out of a game (i.e. reduced to 0 Health or less), he rolls on the Survival Table for wizards and apprentices instead of checking for survival as with other soldiers. All results are handled exactly as they are for spellcasters, with one exception.\n\n\nIf a roll on the Permanent Injury Table ever results in the captain suffering a Smashed Jaw, the following effect is applied instead:\n\n\n**Smashed Jaw (Captain)**\nA captain with a Smashed Jaw may not use group activation, even if he has the Leadership trick. A captain can only receive this injury once. Any further Smashed Jaw results must be re-rolled.",
            "typeId": "15c1-2bd7-8969-1787"
          }
        ]
      },
      {
        "name": "Share of the Treasure",
        "id": "11e8-34fb-cfad-f57f",
        "hidden": false,
        "typeId": "862c-226a-1aca-4ed2",
        "typeName": "Ability",
        "characteristics": [
          {
            "name": "Description",
            "$text": "After each game, the captain takes a percentage equal to the **captain's level +10**, rounded down, of all gold acquired during the game by any means, including the sale of items.\n\n\nA captain does not take a share of magic items unless they are sold or given to him. If a captain is dismissed after a game, he must still be paid his share of gold for the previous game",
            "typeId": "15c1-2bd7-8969-1787"
          }
        ]
      },
      {
        "name": "Tricks of the Trade",
        "id": "2017-e9a8-5f1c-268e",
        "hidden": false,
        "typeId": "862c-226a-1aca-4ed2",
        "typeName": "Ability",
        "characteristics": [
          {
            "name": "Description",
            "$text": "Each trick may be used once, and only once, during a game, so it is important to keep track of which tricks have been used. Using a trick does not require a special action to be taken - a player simply declares that it is being used at the appropriate moment, as noted in the 'When to Declare' column. There is no limit to the number of tricks that may be used with a single action or in any one turn. A captain may use a trick even if he is not currently being activated (e.g. he may choose to employ a Furious Attack in response to being attacked by an enemy model), and if two captains are duelling, both may employ as many tricks as they feel are needed to carry them to victory.\n\n",
            "typeId": "15c1-2bd7-8969-1787"
          }
        ]
      },
